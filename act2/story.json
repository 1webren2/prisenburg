  "nodes": [
    {
      "id": "b1_room",
      "pov": "西比拉",
      "title": "第二幕 · 新房间",
      "art": {
        "bg": "bg_sibylla_room",
        "portrait": "chr_sibylla"
      },
      "povSwitch": {
        "line": "奥布里·德·沃 视角结束 —— 西比拉·德·克莱尔 视角开始"
      },
      "dialogues": [
        {
          "speaker": "旁白",
          "text": "西比拉坐在木床上，双手紧紧地抱住自己带来的一些行李，打量着这个房间，很狭窄，但是这里的待遇，比西比拉这半年间待过的任何一位伯爵公爵家都要好上很多，至少，不再是女仆们挤在一起的隔间。"
        },
        {
          "speaker": "旁白",
          "text": "书桌，床，镜子，一应俱全，甚至奥布里还为她准备了书架，西比拉站起身，将行李放在床上，手指摸着崭新的木柜，看来奥布里并不准备为难她。"
        }
      ],
      "next": "b2_haier_knock"
    },
    {
      "id": "b2_haier_knock",
      "pov": "西比拉",
      "title": "第二幕 · 门外的海尔",
      "art": {
        "bg": "bg_sibylla_room",
        "portrait": "chr_sibylla"
      },
      "dialogues": [
        {
          "speaker": "海尔",
          "text": "西比拉小姐，这是布朗先生叫我送来的衣服。"
        },
        {
          "speaker": "旁白",
          "text": "房外，忽然传来一个稚嫩又胆怯的喊声，不用打开房门，西比拉也知道是谁。"
        },
        {
          "speaker": "旁白",
          "text": "西比拉将门轻轻打开一条不大不小的缝，果然，一个瘦小的身影便出现在她面前，正是海尔，手上举着两套衣服，一套是很经典的女仆服饰，而另一套是作为教师的衣服，西比拉看着像是女牧师的衣服。"
        },
        {
          "speaker": "旁白",
          "text": "她将衣服从海尔手上拿下，笑着说——"
        },
        {
          "speaker": "西比拉",
          "text": "海尔，谢谢你，你现在还有事要做吗？"
        },
        {
          "speaker": "海尔",
          "text": "唉！"
        },
        {
          "speaker": "旁白",
          "text": "海尔突然惊叫一声，随后面容怪异，眼睛四处乱瞟着——"
        },
        {
          "speaker": "海尔",
          "text": "布朗，布朗先生叫我……"
        },
        {
          "speaker": "旁白",
          "text": "海尔憋红了脸，仿佛是要说出什么艰难的话。"
        }
      ],
      "choices": [
        {
          "text": "等着 · 让她自己说完",
          "hint": "她憋红了脸，像是有什么难开口的话",
          "next": "b3_wait"
        },
        {
          "text": "作罢 · 那下次再见了",
          "hint": "她慌乱的样子，你本想放她走",
          "next": "b3_letgo"
        }
      ]
    },
    {
      "id": "b3_wait",
      "pov": "西比拉",
      "title": "第二幕 · 她自己说下去",
      "art": {
        "bg": "bg_sibylla_room",
        "portrait": "chr_sibylla"
      },
      "dialogues": [
        {
          "speaker": "旁白",
          "text": "海尔见状将手卡着门，说道——"
        },
        {
          "speaker": "海尔",
          "text": "西，西比拉小姐，不是这样的，我，管家先生叫我给你交代一些事情。"
        }
      ],
      "next": "b4_enter"
    },
    {
      "id": "b3_letgo",
      "pov": "西比拉",
      "title": "第二幕 · 下次再见",
      "art": {
        "bg": "bg_sibylla_room",
        "portrait": "chr_sibylla"
      },
      "dialogues": [
        {
          "speaker": "西比拉",
          "text": "不愿意吗？没关系的，那下次再见了，海尔。"
        },
        {
          "speaker": "旁白",
          "text": "西比拉见海尔慌乱的样子，倚着房门轻轻说道，随后准备将门关上。"
        },
        {
          "speaker": "旁白",
          "text": "海尔见状将手卡着门，说道——"
        },
        {
          "speaker": "海尔",
          "text": "西，西比拉小姐，不是这样的，我，管家先生叫我给你交代一些事情。"
        }
      ],
      "next": "b4_enter"
    },
    {
      "id": "b4_enter",
      "pov": "西比拉",
      "title": "第二幕 · 进来说吧",
      "art": {
        "bg": "bg_sibylla_room",
        "portrait": "chr_sibylla"
      },
      "dialogues": [
        {
          "speaker": "西比拉",
          "text": "既然这样，小海尔，进来说吧，我也有些疑问想要问你。"
        },
        {
          "speaker": "旁白",
          "text": "西比拉重新将门打开，指着床边，随后将衣服放在了书桌之上。"
        },
        {
          "speaker": "旁白",
          "text": "海尔走进房间，好奇地打量着西比拉的布置，毫不掩饰她的羡慕，眼睛一闪一闪的发着亮，她说道——"
        },
        {
          "speaker": "海尔",
          "text": "西比拉小姐能拥有独立的房间真好啊。"
        }
      ],
      "choices": [
        {
          "text": "问 · 你们是住哪呢",
          "hint": "床垫咔嚓响了一声",
          "next": "b5_quarters"
        },
        {
          "text": "问 · 伯爵大人没有贴身的仆人吗",
          "hint": "三楼只住着伯爵、管家和伊莎贝尔小姐",
          "next": "b5_no_servant"
        }
      ]
    },
    {
      "id": "b5_quarters",
      "pov": "西比拉",
      "title": "第二幕 · 仆人们的住处",
      "art": {
        "bg": "bg_sibylla_room",
        "portrait": "chr_sibylla"
      },
      "dialogues": [
        {
          "speaker": "西比拉",
          "text": "你们是住哪呢？"
        },
        {
          "speaker": "旁白",
          "text": "西比拉牵着海尔在床沿坐下，坐下时西比拉还能听见床垫发出“咔嚓”一声。"
        },
        {
          "speaker": "旁白",
          "text": "海尔说道——"
        },
        {
          "speaker": "海尔",
          "text": "在阁楼的隔间里，所有的低级女仆都是睡在那。"
        },
        {
          "speaker": "旁白",
          "text": "她看着西比拉，补充道——"
        },
        {
          "speaker": "海尔",
          "text": "二楼是厨师长、糕点师和大人的药师住的地方，而三楼是大人、管家先生以及伊莎贝尔小姐居住的地方，现在又加上了西比拉小姐。"
        }
      ],
      "next": "b6_laundry"
    },
    {
      "id": "b5_no_servant",
      "pov": "西比拉",
      "title": "第二幕 · 贴身的仆人",
      "art": {
        "bg": "bg_sibylla_room",
        "portrait": "chr_sibylla"
      },
      "dialogues": [
        {
          "speaker": "西比拉",
          "text": "伯爵大人没有贴身的仆人吗？"
        },
        {
          "speaker": "旁白",
          "text": "西比拉问道。"
        }
      ],
      "next": "b6_laundry"
    },
    {
      "id": "b6_laundry",
      "pov": "西比拉",
      "title": "第二幕 · 洗衣房在一楼",
      "art": {
        "bg": "bg_sibylla_room",
        "portrait": "chr_sibylla"
      },
      "dialogues": [
        {
          "speaker": "海尔",
          "text": "没有，大人不喜欢被打扰。"
        },
        {
          "speaker": "旁白",
          "text": "海尔摇了摇头，嘟着嘴，坐在床上的脚还碰不到地面，随意地晃着，低下头说道——"
        },
        {
          "speaker": "海尔",
          "text": "西比拉小姐，管家先生要我告诉你，洗衣房在一楼，你需要时刻保持衣服的整洁。"
        },
        {
          "speaker": "西比拉",
          "text": "我会记住的。"
        },
        {
          "speaker": "旁白",
          "text": "西比拉笑着说。"
        }
      ],
      "next": "b7_offer"
    },
    {
      "id": "b7_offer",
      "pov": "西比拉",
      "title": "第二幕 · 海尔的好意",
      "art": {
        "bg": "bg_sibylla_room",
        "portrait": "chr_sibylla"
      },
      "dialogues": [
        {
          "speaker": "旁白",
          "text": "海尔瞟了瞟西比拉，脸色忽然变得红润——"
        },
        {
          "speaker": "海尔",
          "text": "要，要是西比拉小姐没有时间，把衣服给我，我可以帮您洗。"
        },
        {
          "speaker": "西比拉",
          "text": "谢谢你的好心，小海尔。"
        },
        {
          "speaker": "旁白",
          "text": "西比拉惊讶地笑起来——"
        },
        {
          "speaker": "西比拉",
          "text": "不过这么一点事，我自己还是能做的。"
        }
      ],
      "next": "b8_farewell"
    },
    {
      "id": "b8_farewell",
      "pov": "西比拉",
      "title": "第二幕 · 送她出门",
      "art": {
        "bg": "bg_sibylla_room",
        "portrait": "chr_sibylla"
      },
      "dialogues": [
        {
          "speaker": "旁白",
          "text": "海尔没有勉强，沉默着晃了晃腿，最后跳下床，转了个身看向西比拉——"
        },
        {
          "speaker": "海尔",
          "text": "西比拉小姐，我还需要清洗士兵换下来的衣服，得回去了。"
        },
        {
          "speaker": "西比拉",
          "text": "海尔要是有什么想问我的，可以随时来找我。"
        },
        {
          "speaker": "旁白",
          "text": "西比拉点了点头，将海尔送出房间，对她说道。"
        },
        {
          "speaker": "海尔",
          "text": "谢谢您，西比拉小姐。"
        },
        {
          "speaker": "旁白",
          "text": "海尔深深地弯腰感谢，终于放松了些——"
        },
        {
          "speaker": "海尔",
          "text": "我走了。"
        },
        {
          "speaker": "西比拉",
          "text": "嗯。"
        },
        {
          "speaker": "旁白",
          "text": "西比拉挥挥手，将房门轻轻关上。"
        }
      ],
      "choices": [
        {
          "text": "歇一歇 · 捏一捏那个枕头",
          "hint": "茅草是新的，枕头是羊毛的",
          "next": "b9_pillow"
        },
        {
          "text": "不歇了 · 直接走到书桌前",
          "hint": "明天要上的课还没备",
          "next": "b10_desk"
        }
      ]
    },
    {
      "id": "b9_pillow",
      "pov": "西比拉",
      "title": "第二幕 · 羊毛枕头",
      "art": {
        "bg": "bg_sibylla_room",
        "portrait": "chr_sibylla"
      },
      "dialogues": [
        {
          "speaker": "旁白",
          "text": "她看了眼狭窄却又空荡的房间，靠在床边，感受着身后的茅草发出咔嚓的声音，奥布里确实很重视她，这些茅草应该都是新的，她拿起枕头，手上微微用力，捏着枕头的手指便陷进去一些，西比拉忽的露出一丝笑容，这枕头却是用羊毛做的，看来在普里森堡的日子最起码可以睡个好觉。"
        }
      ],
      "next": "b10_desk"
    },
    {
      "id": "b10_desk",
      "pov": "西比拉",
      "title": "第二幕 · 蜡版与尖笔",
      "art": {
        "bg": "bg_sibylla_room",
        "portrait": "chr_sibylla"
      },
      "dialogues": [
        {
          "speaker": "旁白",
          "text": "西比拉放下羊毛枕头，走到书桌前，能看见奥布里安排好的纸张和书籍，还有一小瓶墨水与羽毛笔，在这些旁边还放着几块蜡版和尖笔。"
        },
        {
          "speaker": "旁白",
          "text": "她将蜡版放好，拿起那支尖笔，思索着明天要为伊莎贝尔小姐上什么课。"
        },
        {
          "speaker": "旁白",
          "text": "西比拉点起蜡灯，烛光在夜里忽明忽暗，她将尖笔一端咬在嘴里，直到口腔之中终于传来些木头怪味，西比拉脸上终于露出笑容，在蜡版上写下几个字，“教义与礼节”。"
        },
        {
          "speaker": "旁白",
          "text": "敲定了主题，西比拉下笔很快，一字一字地将明天要上课的内容备好，等蜡灯坚持不住熄灭在黑暗中时，西比拉将尖笔放好，满意地望着蜡版，看不清内容，可手指磨过，能够感受到此起彼伏、凹凸不平的刻痕。"
        }
      ],
      "next": "b11_sleep"
    },
    {
      "id": "b11_sleep",
      "pov": "西比拉",
      "title": "第二幕 · 第一夜",
      "art": {
        "bg": "bg_sibylla_room",
        "portrait": "chr_sibylla"
      },
      "dialogues": [
        {
          "speaker": "旁白",
          "text": "西比拉将蜡版放下，匆匆换下衣服，小心地外出洗漱一番后，她回到房间，瘫在床上，脸深深陷进羊毛枕头里，果然很软。"
        },
        {
          "speaker": "旁白",
          "text": "在接受女仆教育的这半年里，西比拉将曾经在克莱尔家中枕过的那个柔软枕头的触感忘得一干二净，如今这个羊毛枕头总算让她找回了些曾经的感觉，西比拉睡得很端正，闭上眼睛后几乎没有再动弹，等再次睁眼时已经是第二天了。"
        }
      ],
      "next": "b12_morning"
    },
    {
      "id": "b12_morning",
      "pov": "西比拉",
      "title": "第二日 · 换上牧师服",
      "art": {
        "bg": "bg_sibylla_room",
        "portrait": "chr_sibylla_teacher"
      },
      "dialogues": [
        {
          "speaker": "旁白",
          "text": "天色刚刚冒出一点微光，西比拉睁开眼睛，很快换上了那身牧师服装，她站在镜子前仔细端详了一会儿，确认无误后拿上蜡版走出房间。"
