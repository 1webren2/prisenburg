      "dialogues": [
        {
          "speaker": "旁白",
          "text": "西比拉打断了伊莎贝尔的叫喊，她低下头，柔和地笑着说——"
        },
        {
          "speaker": "西比拉",
          "text": "伊莎贝尔小姐，我们该开始了。"
