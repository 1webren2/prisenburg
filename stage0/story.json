    {
      "id": "e_classroom_canon",
      "pov": "奥布里",
      "title": "日常 · 教室",
      "art": {
        "bg": "bg_classroom",
        "portrait": "chr_aubrey"
      },
      "dialogues": [
        {
          "speaker": "奥布里",
          "text": "小伊莎贝尔，西比拉小姐曾经是许多小姐们羡慕的对象呢，我想她的优秀离不开严厉的教导，来，继续上课。"
        },
        {
          "speaker": "旁白",
          "text": "不等伊莎贝尔反驳，奥布里将怀中的伊莎贝尔递给西比拉。"
        },
        {
          "speaker": "奥布里",
          "text": "西比拉小姐，伊莎贝尔请你放心使用你的方法教导，只是我希望可以看见成效。"
        },
        {
          "speaker": "旁白",
          "text": "西比拉将伊莎贝尔接过，手中暗暗用力，把伊莎贝尔死死抱住。"
        },
        {
          "speaker": "西比拉老师",
          "text": "遵命，沃大人。"
        },
        {
          "speaker": "旁白",
          "text": "奥布里点点头，离开了教室门口，临走前，门被他顺便关上了。"
        },
        {
          "speaker": "伊莎贝尔",
          "text": "哥哥！哥——"
        },
        {
          "speaker": "旁白",
          "text": "西比拉打断了伊莎贝尔的叫喊。"
        },
        {
          "speaker": "西比拉老师",
          "text": "伊莎贝尔小姐，我们该开始了。"
        }
      ],
      "next": "h_noon"
    },
